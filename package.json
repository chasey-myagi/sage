{
  "name": "sage-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "pnpm check:lint && pnpm check:types && pnpm check:layers && pnpm check:export-docs && pnpm check:readme && pnpm check:log-manifest && pnpm test",
    "gen:log-manifest": "node scripts/gen-log-manifest.mjs",
    "check:log-manifest": "node scripts/gen-log-manifest.mjs --check",
    "check:lint": "biome check --error-on-warnings .",
    "check:types": "tsc -b",
    "check:layers": "node scripts/check-layers.mjs",
    "check:export-docs": "node scripts/check-export-docs.mjs",
    "check:readme": "node scripts/check-readme-model-experience.mjs",
    "test": "vitest run",
    "test:update": "UPDATE_EXPECTED=1 vitest run",
    "test:coverage": "vitest run --coverage",
    "bench:fetch": "node bench/tasks/fetch-swe-verified.mjs",
    "bench:fetch-ts": "node bench/tasks/fetch-multi-swe-ts.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
