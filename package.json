{
  "name": "sage-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm check:lint && pnpm check:types && pnpm check:layers && pnpm check:readme && pnpm test",
